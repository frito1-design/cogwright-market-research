# Copy to .env. Never commit .env (see .gitignore).

# Crawl politeness — these are floors, not suggestions (CW-RES-001 §9).
# Values below the defaults are clamped up by config.py; they cannot be loosened.
CW_MIN_DELAY_PER_DOMAIN=2.0
CW_MAX_CONCURRENT_DOMAINS=8
CW_REQUEST_TIMEOUT=30

# Optional: Google Places key for Stage 1 metro sweeps. Leave blank to skip.
CW_GOOGLE_PLACES_KEY=

# Storage
CW_DB_PATH=data/market.db
